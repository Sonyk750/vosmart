generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Cine intra in aplicatie.
///
/// Roluri: `admin` — proprietarul VoSmart, fara restrictii; `cenzor` — coleg din
/// firma, vede contractele repartizate lui; `client` — persoana desemnata prin
/// contract, care isi descarca rapoartele semnate.
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("client") // admin | cenzor | client
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  /// Contractele de care raspunde, daca e cenzor.
  contracte Contract[] @relation("ContracteCenzor")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Codurile de resetare a parolei. In tabela sta doar amprenta sha256 a codului,
/// nu codul: cine citeste tabela nu poate intra pe niciun cont.
model CodResetareParola {
  id        String   @id @default(cuid())
  email     String
  codHash   String
  expiraLa  DateTime
  incercari Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

/// Contractul de cenzorat dintre VoSmart si o asociatie sau o firma.
///
/// Coloana vertebrala: nu exista luna, documente sau raport fara un contract sub
/// ele. Contractele sunt ale firmei — le adauga proprietarul si, pana la
/// repartizare, tot el le lucreaza.
model Contract {
  id            String    @id @default(cuid())
  numar         String?
  dataSemnarii  DateTime?
  /// Gol inseamna „pe durata nedeterminata", nu „expirat".
  dataIncetarii DateTime?

  // --- Beneficiarul, asa cum apare in contract ---
  denumire     String
  cui          String
  regCom       String?
  adresa       String?
  localitate   String?
  telefon      String?
  email        String?
  /// Presedintele sau administratorul care semneaza din partea asociatiei.
  reprezentant String?

  // --- Persoana desemnata prin contract ---
  // Singura care va putea descarca rapoartele semnate din contul ei. Fara ea,
  // raportul ramane la noi: nu are cine sa-l ridice.
  persoanaNume    String?
  persoanaFunctie String?
  persoanaEmail   String?
  persoanaTelefon String?

  /// Ziua din luna pana la care asociatia trebuie sa trimita documentele.
  ziTermen Int @default(15)

  status     String  @default("activ") // activ | suspendat | incheiat
  observatii String?

  /// Cenzorul din VoSmart care raspunde de contract. Gol = il lucreaza proprietarul.
  cenzorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cenzor  User?    @relation("ContracteCenzor", fields: [cenzorId], references: [id], onDelete: SetNull)
  dosare  Dosar[]
  reports Report[]

  @@index([cui])
  @@index([status])
}

/// Dosarul unei luni, sub un contract.
///
/// Aici se aduna, la un loc, tot ce tine de luna aceea: documentele primite,
/// inventarul lor citit de AI, raportul AI si raportul semnat de cenzor.
/// Se numea `Document`, ceea ce nu se potrivea: nu e un fisier, e un dosar cu
/// mai multe fisiere in el.
model Dosar {
  id         String  @id @default(cuid())
  contractId String
  /// Luna verificata, cu litere mici: „august".
  luna       String
  an         Int
  titlu      String?

  // --- Fluxul de verificare. Vezi lib/cenzorat/pipeline.ts ---
  etapa      String    @default("intrare") // intrare | extragere | verificare | sinteza | revizuire | semnat
  stareEtapa String    @default("asteptare") // asteptare | in_lucru | gata | esuata
  /// Cifrele citite din documente (ExtrasDosar). Din ele se calculeaza tot restul.
  extras     Json?
  /// Cat la suta din datele asteptate s-au gasit efectiv in documente.
  incredere  Int?
  scor       Float?
  verdict    String?
  rezumat    String?
  tokensIn   Int?
  tokensOut  Int?
  inceputLa  DateTime?
  terminatLa DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fisiere    Fisier[]
  constatari Constatare[]
  evenimente EvenimentFlux[]
  reports    Report[]

  /// O singura luna per contract: al doilea dosar pe august ar insemna doua
  /// adevaruri despre aceeasi perioada.
  @@unique([contractId, an, luna])
  @@index([etapa])
}

/// Un fisier din dosar, asa cum sta el in Vercel Blob (store PRIVAT).
///
/// In baza tinem doar adresa; continutul nu se serveste niciodata direct, ci
/// prin ruta de descarcare, care verifica intai a cui e dosarul.
///
/// Scanarile se pastreaza RECODATE, nu asa cum au venit: o pagina A4 la 300 dpi
/// are 5-7 MB si nu se lasa comprimata (un JPEG e deja comprimat), dar recodata
/// la ~200 dpi are 1,2 MB si se citeste la fel. Vezi `lib/cenzorat/optimizare.ts`.
/// Ca sa nu se piarda dovada a ce s-a primit, `amprenta` tine sha256 al
/// fisierului ORIGINAL, calculat inainte de orice atingere.
model Fisier {
  id              String  @id @default(cuid())
  dosarId         String
  tip             String // lista_plata | explicatii_lista | registru_casa | facturi | ...
  eticheta        String
  /// Numele original, asa cum l-a trimis omul.
  numeFisier      String
  /// Adresa din Blob; fara token nu se poate citi.
  blobUrl         String
  /// Tipul octetilor PASTRATI. Poate diferi de ce a trimis browserul, daca s-a recodat.
  mimeType        String
  /// Cat ocupa in stocare, dupa recodare.
  marime          Int
  /// Cat avea cand a fost trimis. Gol la fisierele intrate inainte de recodare.
  marimeOriginala Int?
  /// sha256 (hex) al fisierului original. Raspunsul la „ce mi-ati trimis de fapt?".
  amprenta        String?
  /// A fost recodat la pastrare? Cand e fals, in Blob sta chiar originalul.
  optimizat       Boolean @default(false)

  // --- Inventarul: ce este documentul, citit DIN el, nu din numele fisierului.
  // Vezi lib/cenzorat/inventar.ts. La o factura, `denumireAi` iese „Factură Apa
  // Nova" — furnizorul e lucrul care conteaza intr-un dosar de cenzorat, iar
  // numele fisierului scos de programul de administrare nu-l contine niciodata.
  /// Cum se numeste documentul, in cuvintele lui.
  denumireAi String?
  /// Cine l-a emis, asa cum scrie in antet.
  emitentAi  String?
  /// Perioada la care se refera, ex. „iunie 2026".
  perioadaAi String?
  /// De unde vine `tip`: ai — citit din document; nume — ghicit din numele
  /// fisierului; om — pus cu mana de cenzor, si atunci nu se mai suprascrie.
  tipSursa   String  @default("nume")

  createdAt DateTime @default(now())

  dosar Dosar @relation(fields: [dosarId], references: [id], onDelete: Cascade)

  @@index([dosarId])
}

/// O constatare de cenzorat: ce s-a gasit, cat de grav e, pe ce se sprijina.
model Constatare {
  id          String   @id @default(cuid())
  dosarId     String
  /// Cod stabil (ex. CASA-PLAFON), ca aceeasi problema sa poata fi urmarita de la o luna la alta.
  cod         String
  titlu       String
  detaliu     String
  severitate  String // critica | ridicata | medie | scazuta | info
  sursa       String // regula | ai | cenzor
  temei       String?
  /// Cifrele pe care se sprijina, ca sa nu fie nevoie de redeschiderea PDF-ului.
  probe       Json?
  recomandare String?
  stare       String   @default("deschisa") // deschisa | acceptata | respinsa
  notaCenzor  String?
  ordine      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dosar Dosar @relation(fields: [dosarId], references: [id], onDelete: Cascade)

  @@index([dosarId])
}

/// Jurnalul fluxului. Bara de progres se alimenteaza de aici, nu dintr-un
/// contor care creste singur in browser.
model EvenimentFlux {
  id        String   @id @default(cuid())
  dosarId   String
  etapa     String
  stare     String // in_lucru | gata | esuata
  mesaj     String
  createdAt DateTime @default(now())

  dosar Dosar @relation(fields: [dosarId], references: [id], onDelete: Cascade)

  @@index([dosarId, createdAt])
}

/// Un raport din dosarul lunii.
///
/// Sunt doua feluri, si stau amandoua aici: `ai` — ce a constatat verificarea
/// automata; `expert` — ce a intocmit si a semnat cenzorul. Al doilea il are pe
/// primul in fata cand se scrie, dar nu il inlocuieste: raman amandoua in dosar.
model Report {
  id         String @id @default(cuid())
  dosarId    String
  contractId String
  tip        String @default("ai") // ai | expert

  titlu  String
  /// Raportul in forma structurata: date, constatari, scor.
  date   Json?
  status String @default("draft") // draft | publicat

  semnatDe String?
  semnatLa DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dosar    Dosar    @relation(fields: [dosarId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  /// Un singur raport de fiecare fel intr-un dosar.
  @@unique([dosarId, tip])
  @@index([contractId])
}

/// Cache Q&A pentru asistentul de ajutor: intrebarile fara context se retin
/// normalizate; la o intrebare identica se serveste raspunsul din baza, fara
/// apel la model. `ver` = amprenta manualului; la schimbare, se recalculeaza.
model AsistentCache {
  id           String   @id @default(cuid())
  questionNorm String   @unique
  question     String
  answer       String
  ver          String
  hits         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
